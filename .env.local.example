# --- Sleeper -----------------------------------------------------------------
# Public API. Just your Sleeper username (the @handle, not your display name).
SLEEPER_USERNAME=

# --- ESPN --------------------------------------------------------------------
# Comma-separated league ids. Optionally label one as `id:My Label`.
ESPN_LEAGUES=

# Private leagues need these two cookies from a logged-in browser session:
#   fantasy.espn.com -> DevTools -> Application -> Cookies
ESPN_SWID=
ESPN_S2=

# --- Optional ----------------------------------------------------------------
# Pin a season instead of using the live NFL season.
FANTASY_SEASON=
